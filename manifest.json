{
  "manifest_version": 2,
  "name": "Persian Layout Fix - Smart Text Converter",
  "version": "1.0.0",
  "description": "Intelligently converts text between Persian and English keyboard layouts with auto-detection. Perfect for bilingual typing!",
  
  "applications": {
    "gecko": {
      "id": "persian-layout-fix@yourdomain.com",
      "strict_min_version": "78.0"
    }
  },
  
  "permissions": [
    "activeTab",
    "<all_urls>"
  ],
  
  "browser_action": {
    "default_title": "Persian Layout Fix - Auto Convert Text (Alt+Shift+P)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  
  "commands": {
    "auto-convert": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Auto-convert selected text between Persian and English layouts"
    }
  },
  
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  
  "homepage_url": "https://github.com/fireproof/persian-layout-fix",
  
  "developer": {
    "name": "ebaharloo"
  }
}