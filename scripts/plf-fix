#!/usr/bin/env bash
# System-wide Persian/English layout fix on Wayland (KDE).
# Select text in any app, press the global shortcut: text is converted in place.
# Usage: plf-fix           convert the current selection (Ctrl+C / convert / Ctrl+V)
#        plf-fix --clip    convert the clipboard only, no key injection
set -uo pipefail

CLI="$(dirname "$(readlink -f "$0")")/cli.js"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/plf-fix.log"
notify() { notify-send -a "Persian Layout Fix" "Persian Layout Fix" "$1"; }
log() {
  mkdir -p "$(dirname "$LOG")"
  printf '%s\t%s\n' "$(date '+%F %T')" "$1" >> "$LOG"
}

if [ "${1:-}" = "--clip" ]; then
  text=$(wl-paste --no-newline 2>/dev/null) || { notify "❌ clipboard empty"; log "fail: clipboard empty"; exit 1; }
else
  original=$(wl-paste --no-newline 2>/dev/null || true)
  before=$original
  ydotool key --delay 30 ctrl+c
  for _ in $(seq 20); do  # wait for the app to fill the clipboard
    sleep 0.03
    text=$(wl-paste --no-newline 2>/dev/null || true)
    [ "$text" != "$before" ] && break
  done
  [ -n "${text:-}" ] || { notify "❌ select some text first"; log "fail: no selection"; exit 1; }
fi

converted=$(printf '%s' "$text" | node "$CLI") || { notify "❌ cant detect language"; log "fail: no direction | in=$text"; exit 1; }
[ "$converted" = "$text" ] && { notify "❌ nothing to convert"; log "fail: unchanged | in=$text"; exit 1; }

printf '%s' "$converted" | wl-copy

if [ "${1:-}" != "--clip" ]; then
  # Retype by keystrokes over the still-active selection: switch to the layout that
  # produces the wanted characters, type, switch back. KWin has no virtual-keyboard
  # protocol (wtype fails), and ydotool can only send keycodes, not Unicode.
  spec=$(printf '%s' "$text" | node "$CLI" --keys) || spec=""
  target=${spec%%$'\t'*}
  keys=${spec#*$'\t'}
  case "$target" in
    fa) im=keyboard-ir-winkeys ;;
    en) im=keyboard-us ;;
    *)  im="" ;;
  esac

  if [ -n "$im" ] && command -v ydotool >/dev/null && command -v fcitx5-remote >/dev/null; then
    prev_im=$(fcitx5-remote -n)
    fcitx5-remote -s "$im"
    sleep 0.15                       # let the layout switch apply before keystrokes
    if ! ydotool type -d 20 -- "$keys"; then
      fcitx5-remote -s "$prev_im"          # never leave the user on the wrong layout
      log "fail: typing failed | in=$text | clipboard kept"
      notify "❌ typing failed - text is in your clipboard"
      exit 1
    fi
    sleep 0.05
    fcitx5-remote -s "$prev_im"
    if [ -n "${original:-}" ]; then printf '%s' "$original" | wl-copy; else wl-copy --clear; fi
  else
    sleep 0.05
    ydotool key --delay 30 ctrl+v   # shortcut: clipboard left holding the converted text when keys path unavailable
  fi
fi

short=$(printf '%s' "$converted" | head -c 60)
log "ok | in=$text | out=$converted"
notify "✅ $short"
