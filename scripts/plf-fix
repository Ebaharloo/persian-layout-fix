#!/usr/bin/env bash
# System-wide Persian/English layout fix on Wayland (KDE).
# Select text in any app, press the shortcut / click the widget: it is retyped in the
# right layout. No copy step - the text comes from the Wayland PRIMARY selection.
# Usage: plf-fix           fix the current selection
#        plf-fix --copy    apps that do not publish a primary selection (uses Ctrl+C)
#        plf-fix --clip    convert the clipboard only (no typing)
set -uo pipefail

DIR="$(dirname "$(readlink -f "$0")")"
CLI="$DIR/cli.js"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
LOG="$STATE_DIR/plf-fix.log"
LAST="$STATE_DIR/plf-fix.last"
FA_IM=keyboard-ir-winkeys
EN_IM=keyboard-us

notify() { notify-send -a "Persian Layout Fix" "Persian Layout Fix" "$1"; }
log() {
  mkdir -p "$STATE_DIR"
  printf '%s\t%s\n' "$(date '+%F %T')" "$1" >> "$LOG"
}
fail() { notify "❌ $1"; log "fail: $1${2:+ | in=$2}"; exit 1; }

mode=${1:-}

if [ "$mode" = "--clip" ]; then
  text=$(wl-paste --no-newline 2>/dev/null) || fail "clipboard empty"
elif [ "$mode" = "--copy" ]; then
  before=$(wl-paste --no-newline 2>/dev/null || true)
  ydotool key ctrl+c
  text=""
  for _ in $(seq 20); do
    sleep 0.03
    text=$(wl-paste --no-newline 2>/dev/null || true)
    [ -n "$text" ] && [ "$text" != "$before" ] && break
    text=""
  done
  [ -n "$text" ] || fail "no selection (app did not copy)"
else
  text=$(wl-paste --primary --no-newline 2>/dev/null || true)
  [ -n "${text//[[:space:]]/}" ] || fail "nothing selected"
  # PRIMARY keeps the previous value, so the same text twice means nothing new was selected.
  [ "$text" = "$(cat "$LAST" 2>/dev/null || true)" ] && fail "already fixed this one - select the new text"
fi

converted=$(printf '%s' "$text" | node "$CLI") || fail "cant detect language" "$text"
[ "$converted" = "$text" ] && fail "nothing to convert" "$text"

if [ "$mode" = "--clip" ]; then
  printf '%s' "$converted" | wl-copy
  log "ok(clip) | in=$text | out=$converted"
  notify "✅ $converted"
  exit 0
fi

spec=$(printf '%s' "$text" | node "$CLI" --keys) || fail "cant build keystrokes" "$text"
target=${spec%%$'\t'*}
keys=${spec#*$'\t'}
case "$target" in
  fa) im=$FA_IM ;;
  en) im=$EN_IM ;;
  *)  fail "no target layout" "$text" ;;
esac

prev_im=$(fcitx5-remote -n 2>/dev/null || echo "$EN_IM")
fcitx5-remote -s "$im" || fail "cant switch input method" "$text"
sleep 0.15                                   # let fcitx5 apply the layout before typing
if ! ydotool type -d 20 -- "$keys"; then
  fcitx5-remote -s "$prev_im"                 # never leave the user on the wrong layout
  fail "typing failed" "$text"
fi
sleep 0.05
fcitx5-remote -s "$prev_im"

printf '%s' "$text" > "$LAST"
log "ok | in=$text | out=$converted | typed=$keys ($target)"
notify "✅ $converted"
